{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "vite --clearScreen false --logLevel info",
    "build": "bun run typecheck && vite build",
    "start": "bun run build && bun run preview",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --port ${PORT:-4173} --strictPort",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.83.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@moatless/inspector": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.11.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "vite": "~7.3.8"
  }
}
